# Speech Recognition (Streaming ASR)
DEEPGRAM_API_KEY=

# LLM Reasoning (Provide either GROQ_API_KEY or OPENAI_API_KEY)
# Option 1: Groq (Recommended for lowest latency & free tier)
GROQ_API_KEY=

# Option 2: OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_BASE_URL=

# Streaming TTS (optional — falls back to browser speechSynthesis if unset)
# TTS_PROVIDER: auto | cartesia | elevenlabs | browser
TTS_PROVIDER=
CARTESIA_API_KEY=
ELEVENLABS_API_KEY=

# Server Settings
PORT=
HOST=
NODE_ENV=
ASR_CONNECT_TIMEOUT_MS=
LLM_REQUEST_TIMEOUT_MS=
TOOL_REQUEST_TIMEOUT_MS=
TTS_CONNECT_TIMEOUT_MS=
TTS_RESPONSE_TIMEOUT_MS=
TTS_STREAMING_MODE=
DATA_RETENTION_DAYS=
SENTRY_DSN=

# Database & Cache (Docker)
POSTGRES_PASSWORD=
DATABASE_URL=
REDIS_URL=

# Client
NEXT_PUBLIC_WS_URL=
