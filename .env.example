# Speech Recognition (Streaming ASR)
DEEPGRAM_API_KEY=""

# LLM Reasoning (Provide either GROQ_API_KEY or OPENAI_API_KEY)
# Option 1: Groq (Recommended for lowest latency & free tier)
GROQ_API_KEY=""

# Option 2: OpenAI
OPENAI_API_KEY=""
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# Streaming TTS (optional — falls back to browser speechSynthesis if unset)
# TTS_PROVIDER: auto | cartesia | elevenlabs | browser
TTS_PROVIDER=auto
CARTESIA_API_KEY=""
ELEVENLABS_API_KEY=""

# Server Settings
PORT=8080
HOST=0.0.0.0
NODE_ENV=development
ASR_CONNECT_TIMEOUT_MS=10000
LLM_REQUEST_TIMEOUT_MS=30000
TOOL_REQUEST_TIMEOUT_MS=10000
TTS_CONNECT_TIMEOUT_MS=10000
TTS_RESPONSE_TIMEOUT_MS=15000
TTS_STREAMING_MODE=sentence
DATA_RETENTION_DAYS=30
SENTRY_DSN=""

# Database & Cache (Docker)
POSTGRES_PASSWORD=""
DATABASE_URL=""
REDIS_URL=redis://localhost:6379

# Client
NEXT_PUBLIC_WS_URL=ws://localhost:8080/ws
