# Speech Recognition (Streaming ASR)
DEEPGRAM_API_KEY=your_deepgram_api_key_here

# LLM Reasoning (Provide either GROQ_API_KEY or OPENAI_API_KEY)
# Option 1: Groq (Recommended for lowest latency & free tier)
GROQ_API_KEY=your_groq_api_key_here

# Option 2: OpenAI
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# Streaming TTS (optional — falls back to browser speechSynthesis if unset)
# TTS_PROVIDER: auto | cartesia | elevenlabs | browser
TTS_PROVIDER=auto
CARTESIA_API_KEY=your_cartesia_api_key_here
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# Server Settings
PORT=8080
HOST=0.0.0.0
NODE_ENV=development

# Database & Cache (Docker)
DATABASE_URL=postgresql://postgres:pass@localhost:5432/voiceassistant
REDIS_URL=redis://localhost:6379

# Client
NEXT_PUBLIC_WS_URL=ws://localhost:8080/ws
