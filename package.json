{
  "name": "real-time-voice-assistant",
  "private": true,
  "packageManager": "pnpm@10.11.1",
  "scripts": {
    "dev:web": "pnpm --dir apps/web dev",
    "dev:server": "pnpm --dir apps/server dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm --dir apps/server test",
    "eval:latency": "pnpm --dir apps/server exec tsx ../../eval/latency-report.ts",
    "eval:wer": "pnpm --dir apps/server exec tsx ../../eval/wer.ts"
  }
}
